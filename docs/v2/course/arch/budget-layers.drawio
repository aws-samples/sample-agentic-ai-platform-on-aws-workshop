<mxfile host="app.diagrams.net"><diagram id="budget-layers" name="Budget scopes and enforced caps"><mxGraphModel dx="800" dy="500" grid="1" gridSize="10" page="1" pageWidth="800" pageHeight="500" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Budget scopes and the caps this workshop enforces&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#16191f;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="760" height="26" as="geometry"/></mxCell><mxCell id="c4" value="Design for several scopes; know which usage each enforced limit counts." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontStyle=0;fontColor=#545b64;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="760" height="20" as="geometry"/></mxCell><mxCell id="c5" value="Design scopes · production" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#8a94a6;strokeWidth=1.2;dashed=1;dashPattern=5 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#16191f;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="20" y="66" width="370" height="330" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Project cost envelope&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;models + memory + knowledge + runtime + other services&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=#8a94a6;strokeWidth=1.2;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#16191f;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="36" y="98" width="338" height="282" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Agent budget&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;spend across the agent&#x27;s runs and loops&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fff6e8;strokeColor=#d19a3d;strokeWidth=1.2;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#16191f;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="56" y="164" width="298" height="196" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Model usage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;token cost, rate and capacity per model&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a94a6;strokeWidth=1.2;fontSize=13;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="76" y="236" width="258" height="104" as="geometry"/></mxCell><mxCell id="c9" value="Enforced in this workshop · LiteLLM" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fff8ea;strokeColor=#ff9900;strokeWidth=2.4;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#16191f;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="410" y="66" width="370" height="330" as="geometry"/></mxCell><mxCell id="c10" value="this workshop" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffe3b3;strokeColor=none;fontSize=11;fontStyle=1;fontColor=#6b3d00;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="672" y="72" width="96" height="20" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Team cap · one per project&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;hr-assistant: 5 USD per 7 days, tpm and rpm limits&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fff6e8;strokeColor=#d19a3d;strokeWidth=1.2;fontSize=13;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="428" y="104" width="334" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Key cap · Dev&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;hr-assistant-dev-claude-sonnet-5: 1 USD per 7 days&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a94a6;strokeWidth=1.2;fontSize=13;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="428" y="208" width="334" height="56" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Key cap · Prod&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;hr-assistant-prod-claude-sonnet-5: 1 USD per 7 days, created at promotion&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a94a6;strokeWidth=1.2;fontSize=13;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="428" y="284" width="334" height="56" as="geometry"/></mxCell><mxCell id="c14" value="one key per agent, environment and model" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#4a5a70;strokeWidth=1.6;fontSize=11;fontColor=#545b64;fontFamily=Amazon Ember,Helvetica Neue,Arial;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#4a5a70;strokeWidth=1.6;fontSize=11;fontColor=#545b64;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Amazon Ember,Helvetica Neue,Arial;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="Each model call counts against its key and its team." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11.5;fontStyle=0;fontColor=#545b64;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="428" y="350" width="334" height="30" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Not under a hard cap:&lt;/b&gt; a project&#x27;s memory, knowledge base, runtime and other service costs. AWS Budgets by tag alerts on them; it does not block calls." style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#c9d2dc;strokeWidth=1;fontSize=11.5;fontColor=#3a4452;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="20" y="412" width="760" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
