<mxfile host="app.diagrams.net"><diagram id="model-fanout" name="Cross-account model routing"><mxGraphModel dx="800" dy="540" grid="1" gridSize="10" page="1" pageWidth="800" pageHeight="540" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Cross-account model routing through LiteLLM&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#16191f;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="560" height="26" as="geometry"/></mxCell><mxCell id="c4" value="reference pattern · not deployed" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=none;fontSize=11;fontStyle=1;fontColor=#3a4452;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="580" y="13" width="200" height="20" as="geometry"/></mxCell><mxCell id="c5" value="A production pattern to evaluate for capacity and resilience. This workshop runs one account and one deployment per alias." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontStyle=0;fontColor=#545b64;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="760" height="20" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Agent workloads&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;call one alias with a scoped model key&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fff6e8;strokeColor=#d19a3d;strokeWidth=1.2;fontSize=13;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="20" y="104" width="170" height="240" as="geometry"/></mxCell><mxCell id="c7" value="Platform account" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#8a94a6;strokeWidth=1.2;dashed=1;dashPattern=5 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#16191f;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="210" y="66" width="250" height="316" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Private LiteLLM gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;one alias → several deployments; routing, health checks, retries and fallback; budgets per key&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=#8a94a6;strokeWidth=1.2;fontSize=13;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="226" y="114" width="218" height="220" as="geometry"/></mxCell><mxCell id="c9" value="Model account A" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#8a94a6;strokeWidth=1.2;dashed=1;dashPattern=5 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#16191f;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="500" y="66" width="280" height="150" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Scoped invocation role&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;trusted by the gateway&#x27;s role&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a94a6;strokeWidth=1.2;fontSize=13;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="516" y="94" width="248" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;inference profile · model access · quotas&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fff6e8;strokeColor=#d19a3d;strokeWidth=1.2;fontSize=13;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="516" y="152" width="248" height="56" as="geometry"/></mxCell><mxCell id="c12" value="Model account B" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#8a94a6;strokeWidth=1.2;dashed=1;dashPattern=5 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#16191f;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="500" y="232" width="280" height="150" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Scoped invocation role&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;trusted by the gateway&#x27;s role&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a94a6;strokeWidth=1.2;fontSize=13;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="516" y="260" width="248" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;inference profile · model access · quotas&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fff6e8;strokeColor=#d19a3d;strokeWidth=1.2;fontSize=13;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="516" y="318" width="248" height="56" as="geometry"/></mxCell><mxCell id="c15" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#4a5a70;strokeWidth=1.6;fontSize=11;fontColor=#545b64;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Amazon Ember,Helvetica Neue,Arial;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#4a5a70;strokeWidth=1.6;fontSize=11;fontColor=#545b64;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Amazon Ember,Helvetica Neue,Arial;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#4a5a70;strokeWidth=1.6;fontSize=11;fontColor=#545b64;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Amazon Ember,Helvetica Neue,Arial;" edge="1" parent="1" source="c8" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Requires:&lt;/b&gt; cross-account trust per role · private access from the gateway · model access and quotas in every account · retry and fallback rules · spend attributed back to the calling key" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#c9d2dc;strokeWidth=1;fontSize=11.5;fontColor=#3a4452;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="20" y="396" width="760" height="52" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Caveats:&lt;/b&gt; adds usable capacity only once each account&#x27;s quotas, model access and failure domains are validated · does not change where a request may be processed: each inference profile&#x27;s geography, IAM and SCPs still apply · no failover guarantee when the shared Region or the provider is degraded" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fbfcfd;strokeColor=#c9d2dc;strokeWidth=1;fontSize=11.5;fontColor=#3a4452;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="20" y="458" width="760" height="68" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
