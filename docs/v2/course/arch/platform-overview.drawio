<mxfile host="app.diagrams.net"><diagram id="platform-overview" name="Platform overview"><mxGraphModel dx="800" dy="560" grid="1" gridSize="10" page="1" pageWidth="800" pageHeight="560" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;An agentic AI platform&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#16191f;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="520" height="26" as="geometry"/></mxCell><mxCell id="c4" value="Shared capabilities, built once, that every project uses to build, govern, release and operate agents." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontStyle=0;fontColor=#545b64;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="760" height="20" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Project teams&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;build and release their agents&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f2f9e9;strokeColor=#7ea85a;strokeWidth=1.2;fontSize=13;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="20" y="66" width="240" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Domain approvers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;accept business behaviour&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f2f9e9;strokeColor=#7ea85a;strokeWidth=1.2;fontSize=13;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="280" y="66" width="240" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Platform team&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;runs the shared capabilities&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f2f9e9;strokeColor=#7ea85a;strokeWidth=1.2;fontSize=13;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="540" y="66" width="240" height="50" as="geometry"/></mxCell><mxCell id="c8" value="Example workloads · they exercise the platform" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#8a94a6;strokeWidth=1.2;dashed=1;dashPattern=5 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#16191f;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="20" y="132" width="760" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;HR assistant · People Operations&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;blueprint to Prod; an on-behalf-of variant in Dev&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fff6e8;strokeColor=#d19a3d;strokeWidth=1.2;fontSize=13;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="34" y="160" width="360" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Invoice helper · Finance Operations&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;one tool, no agent: proves isolation&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fff6e8;strokeColor=#d19a3d;strokeWidth=1.2;fontSize=13;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="406" y="160" width="360" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Platform interfaces&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;web UI · platform API · blueprints · the workshop command&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=#8a94a6;strokeWidth=1.2;fontSize=13;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="20" y="248" width="760" height="46" as="geometry"/></mxCell><mxCell id="c12" value="Shared platform capabilities" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#8a94a6;strokeWidth=1.2;dashed=1;dashPattern=5 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#16191f;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="760" height="150" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Identity&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;people, workloads, delegated access&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#545b64&quot;&gt;module 2&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a94a6;strokeWidth=1.2;fontSize=12.5;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="31" y="340" width="116" height="104" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Governance&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;domains, projects, catalogue&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#545b64&quot;&gt;module 3&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a94a6;strokeWidth=1.2;fontSize=12.5;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="155" y="340" width="116" height="104" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Tool access&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;gateways, policies&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#545b64&quot;&gt;module 4&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a94a6;strokeWidth=1.2;fontSize=12.5;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="279" y="340" width="116" height="104" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Model access&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;model gateway, guardrails, budgets&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#545b64&quot;&gt;module 5&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a94a6;strokeWidth=1.2;fontSize=12.5;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="403" y="340" width="116" height="104" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Delivery&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;blueprints, release pipeline&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#545b64&quot;&gt;module 6&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a94a6;strokeWidth=1.2;fontSize=12.5;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="527" y="340" width="116" height="104" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Operations&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;traces, scores, spend&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#545b64&quot;&gt;module 7&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a94a6;strokeWidth=1.2;fontSize=12.5;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="651" y="340" width="116" height="104" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Landing zone · module 1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#545b64&quot;&gt;accounts, private network, infrastructure code&lt;/span&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#eef0f3;strokeColor=#8a94a6;strokeWidth=1.2;fontSize=13;fontColor=#16191f;align=center;verticalAlign=middle;spacing=6;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="20" y="476" width="760" height="46" as="geometry"/></mxCell><mxCell id="c20" value="Built bottom-up, one layer per module: landing zone → identity → governance → tool access → model access → delivery → operations." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontStyle=0;fontColor=#545b64;fontFamily=Amazon Ember,Helvetica Neue,Arial;" vertex="1" parent="1"><mxGeometry x="20" y="530" width="760" height="24" as="geometry"/></mxCell><mxCell id="c21" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#4a5a70;strokeWidth=1.6;fontSize=11;fontColor=#545b64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.27;entryY=0;entryDx=0;entryDy=0;fontFamily=Amazon Ember,Helvetica Neue,Arial;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c2