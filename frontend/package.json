{
  "name": "agent-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AnyCompany Agent Platform control plane (Cloudscape) - Phase 2B of the AgentCore workshop",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "e2e": "playwright test",
    "e2e:cloudfront": "BASE_URL=$(aws ssm get-parameter --name /agent-platform/ui/url --query Parameter.Value --output text) playwright test"
  },
  "dependencies": {
    "@cloudscape-design/chat-components": "^1.0.178",
    "@cloudscape-design/collection-hooks": "^1.0.110",
    "@cloudscape-design/components": "^3.0.1396",
    "@cloudscape-design/design-tokens": "^3.0.114",
    "@cloudscape-design/global-styles": "^1.0.71",
    "@tanstack/react-query": "^5.104.1",
    "oidc-client-ts": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-oidc-context": "^3.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
