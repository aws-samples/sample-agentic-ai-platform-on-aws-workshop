{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WorkshopAdminLike",
      "Effect": "Allow",
      "Action": "*",
      "Resource": "*"
    },
    {
      "Sid": "DenyAccountOrganizationAndBillingMutations",
      "Effect": "Deny",
      "Action": [
        "organizations:*",
        "account:*",
        "aws-portal:*",
        "billing:*",
        "payments:*",
        "invoicing:*",
        "tax:*",
        "cur:*",
        "purchase-orders:*",
        "consolidatedbilling:*",
        "freetier:*",
        "savingsplans:*",
        "controltower:*",
        "sso:*",
        "sso-directory:*",
        "identitystore:*",
        "route53domains:*",
        "ec2:PurchaseReservedInstancesOffering",
        "ec2:PurchaseHostReservation",
        "ec2:PurchaseCapacityBlock",
        "rds:PurchaseReservedDBInstancesOffering",
        "cloudtrail:DeleteTrail",
        "cloudtrail:StopLogging",
        "cloudtrail:UpdateTrail"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyIamUsersKeysAndAccountSettings",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:DeleteUser",
        "iam:CreateAccessKey",
        "iam:UpdateAccessKey",
        "iam:CreateLoginProfile",
        "iam:UpdateLoginProfile",
        "iam:CreateVirtualMFADevice",
        "iam:CreateAccountAlias",
        "iam:DeleteAccountAlias",
        "iam:UpdateAccountPasswordPolicy",
        "iam:DeleteAccountPasswordPolicy",
        "iam:CreateSAMLProvider",
        "iam:UpdateSAMLProvider",
        "iam:DeleteSAMLProvider"
      ],
      "Resource": "*"
    }
  ]
}
